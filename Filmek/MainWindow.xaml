<Window x:Class="Filmek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Filmek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10">
            <Button Content="Filmek betöltése" Click="BtnBetoltes_Click" Margin="0,4" Padding="5"/>
            <Button Content="Hány film van?" Click="BtnDarab_Click" Margin="0,4" Padding="5"/>
            <Button Content="Leghosszabb film?" Click="BtnLeghosszabb_Click" Margin="0,4" Padding="5"/>
            <Button Content="Átlag értékelés" Click="BtnAtlag_Click" Margin="0,4" Padding="5"/>
            <Button Content="Csak sci-fi" Click="BtnScifi_Click" Margin="0,4" Padding="5"/>
            <Button Content="Csak címek" Click="BtnCimek_Click" Margin="0,4" Padding="5"/>
            <Button Content="Rendezés cím szerint" Click="BtnRendezes_Click" Margin="0,4" Padding="5"/>
            <ProgressBar x:Name="ProgressBar" Height="20" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
        </StackPanel>

        <DataGrid x:Name="DataGrid" Grid.Column="1" Margin="10" AutoGenerateColumns="True" 
                  SelectionChanged="DgFilmek_SelectionChanged" IsReadOnly="True"/>
    </Grid>
</Window>
